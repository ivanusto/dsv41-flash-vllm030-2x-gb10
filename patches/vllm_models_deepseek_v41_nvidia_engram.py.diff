+        if ids.shape[1] < local_heads:
+            pad = torch.full(
+                (num_tokens, local_heads - ids.shape[1]), -1, dtype=torch.int64
+            )
+            ids = torch.cat((ids, pad), dim=1)
+        # Same ownership rule as _engram_lookup_kernel: padded heads and ids
+        # outside this rank's buckets produce zero rows.
